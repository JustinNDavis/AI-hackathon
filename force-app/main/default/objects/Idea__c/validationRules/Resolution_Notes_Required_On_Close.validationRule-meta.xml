<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Notes_Required_On_Close</fullName>
    <active>true</active>
    <description>Require resolution notes when status is Implemented or Not Pursued.</description>
    <errorConditionFormula>
        OR(
            ISPICKVAL(Status__c, "Implemented"),
            ISPICKVAL(Status__c, "Not Pursued")
        )
        &amp;&amp;
        ISBLANK(Resolution_Notes__c)
    </errorConditionFormula>
    <errorDisplayField>Resolution_Notes__c</errorDisplayField>
    <errorMessage>Resolution notes are required when closing an idea as Implemented or Not Pursued.</errorMessage>
</ValidationRule>

